{
  "name": "mlack",
  "version": "1.0.0",
  "description": "A slack-like app experiment",
  "main": "hono/index.ts",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:client && wrangler dev",
    "build": "pnpm build:client && pnpm build:check",
    "build:client": "tsc --project tsconfig.client.json",
    "build:check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --logHeapUsage",
    "test:e2e": "playwright test",
    "lint": "biome check --verbose .",
    "lint:fix": "biome check --verbose --write .",
    "db:migrate": "wrangler d1 migrations apply mlack-db --local",
    "db:seed": "wrangler d1 execute mlack-db --local --file=hono/db/seed.sql",
    "db:migrate:prod": "wrangler d1 migrations apply mlack-db --remote --env production",
    "db:seed:prod": "wrangler d1 execute mlack-db --remote --env production --file=hono/db/seed.sql",
    "deploy": "pnpm build:client && wrangler deploy --env production"
  },
  "keywords": [
    "hono",
    "slack",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
